{
  "system": {
    "name": "AudioProcessingSystem",
    "version": "1.0.0",
    "environment": "production",
    "debug": false
  },
  "audio": {
    "sample_rate": 48000,
    "frame_size": 480,
    "channels": 8,
    "buffer_size": 4096,
    "device_config": {
      "input_device": null,
      "output_device": null,
      "input_channels": 8,
      "output_channels": 2
    }
  },
  "classroom": {
    "room_dimensions": {
      "length": 12.0,
      "width": 8.0,
      "height": 3.0
    },
    "microphone_array": {
      "positions": [
        [0.0, 0.0, 2.5],
        [2.0, 0.0, 2.5],
        [4.0, 0.0, 2.5],
        [6.0, 0.0, 2.5],
        [0.0, 2.0, 2.5],
        [2.0, 2.0, 2.5],
        [4.0, 2.0, 2.5],
        [6.0, 2.0, 2.5]
      ],
      "geometry": "linear"
    },
    "speaker_positions": [
      [1.0, 8.0, 2.8],
      [5.0, 8.0, 2.8]
    ],
    "teacher_area": {
      "x_range": [0.0, 6.0],
      "y_range": [0.0, 3.0]
    },
    "student_area": {
      "x_range": [0.0, 6.0],
      "y_range": [3.0, 8.0]
    }
  },
  "services": {
    "capture": {
      "enabled": true,
      "priority": 10,
      "config": {
        "sync_tolerance_ms": 1.0,
        "timestamp_precision": "microsecond"
      }
    },
    "ssl": {
      "enabled": true,
      "priority": 9,
      "config": {
        "algorithm": "SRP-PHAT",
        "update_interval_ms": 100,
        "direction_smoothing": 0.8,
        "min_confidence": 0.6
      }
    },
    "beamformer": {
      "enabled": true,
      "priority": 8,
      "config": {
        "algorithm": "MVDR",
        "adaptation_rate": 0.1,
        "noise_floor_db": -40.0
      }
    },
    "aec": {
      "enabled": true,
      "priority": 7,
      "config": {
        "filter_length": 256,
        "adaptation_rate": 0.1,
        "double_talk_threshold": 0.5,
        "erle_target_db": 20.0
      }
    },
    "denoise": {
      "enabled": true,
      "priority": 6,
      "config": {
        "algorithm": "RNNoise",
        "strength": "moderate",
        "preserve_speech": true
      }
    },
    "agc": {
      "enabled": true,
      "priority": 5,
      "config": {
        "target_level_dbfs": -18.0,
        "max_gain_db": 20.0,
        "attack_time_ms": 20.0,
        "release_time_ms": 400.0,
        "teacher_boost_db": 3.0,
        "student_reduction_db": -6.0
      }
    },
    "mixer": {
      "enabled": true,
      "priority": 4,
      "config": {
        "pa_output": {
          "target_level_dbfs": -18.0,
          "limiter_threshold_dbfs": -6.0,
          "eq_enabled": true
        },
        "recording_output": {
          "target_level_dbfs": -20.0,
          "format": "stereo",
          "quality": "high"
        }
      }
    },
    "recorder": {
      "enabled": true,
      "priority": 3,
      "config": {
        "formats": ["PCM", "AAC"],
        "bitrate": 128000,
        "auto_segment": true,
        "segment_duration_min": 30
      }
    },
    "telemetry": {
      "enabled": true,
      "priority": 2,
      "config": {
        "metrics_interval_ms": 1000,
        "log_level": "INFO",
        "export_prometheus": true
      }
    },
    "control": {
      "enabled": true,
      "priority": 1,
      "config": {
        "web_port": 8000,
        "websocket_enabled": true,
        "auth_required": false
      }
    }
  },
  "performance": {
    "max_latency_ms": 40.0,
    "cpu_limit_percent": 80.0,
    "memory_limit_mb": 2048,
    "optimization_mode": "balanced"
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "file_path": "/opt/audio-processing-system/logs/application.log",
    "max_file_size_mb": 100,
    "backup_count": 10,
    "structured_logging": true
  },
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "port": 9090,
      "metrics_path": "/metrics"
    },
    "health_check": {
      "enabled": true,
      "interval_s": 30,
      "timeout_s": 10
    }
  },
  "security": {
    "api_key_required": false,
    "cors_enabled": true,
    "allowed_origins": ["*"],
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 60
    }
  },
  "storage": {
    "recordings_path": "/opt/audio-processing-system/recordings",
    "logs_path": "/opt/audio-processing-system/logs",
    "config_backup_path": "/opt/audio-processing-system/backups",
    "cleanup": {
      "auto_cleanup": true,
      "retention_days": 30
    }
  }
}