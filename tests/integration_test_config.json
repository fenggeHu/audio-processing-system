{
  "test_configuration": {
    "description": "Integration Test Framework Configuration for Audio Processing System",
    "version": "1.0.0",
    "audio_config": {
      "sample_rate": 48000,
      "frame_size": 480,
      "channels": 2,
      "bit_depth": 16
    },
    "test_environments": {
      "development": {
        "timeout_multiplier": 1.0,
        "regression_testing": true,
        "capture_baselines": false,
        "verbose": true
      },
      "ci_cd": {
        "timeout_multiplier": 1.5,
        "regression_testing": true,
        "capture_baselines": false,
        "verbose": false
      },
      "performance": {
        "timeout_multiplier": 2.0,
        "regression_testing": true,
        "capture_baselines": true,
        "verbose": true
      }
    },
    "test_suites": {
      "core_integration": {
        "name": "CoreIntegrationTests",
        "description": "Core audio processing pipeline integration tests",
        "timeout_seconds": 120,
        "required_services": [
          "CaptureService",
          "DenoiseService", 
          "AECService",
          "SSLService",
          "RecorderService"
        ],
        "tests": [
          "test_complete_audio_pipeline",
          "test_real_time_processing_latency"
        ]
      },
      "performance": {
        "name": "PerformanceTests",
        "description": "Performance, scalability, and throughput tests",
        "timeout_seconds": 300,
        "required_services": [
          "DenoiseService",
          "AECService", 
          "SSLService"
        ],
        "tests": [
          "test_concurrent_stream_processing",
          "test_system_stability_under_load"
        ]
      },
      "classroom_scenarios": {
        "name": "ClassroomScenarioTests",
        "description": "Realistic classroom environment and scenario tests",
        "timeout_seconds": 180,
        "required_services": [
          "DenoiseService",
          "SSLService",
          "RecorderService"
        ],
        "tests": [
          "test_classroom_scenario_processing"
        ]
      },
      "resilience": {
        "name": "ResilienceTests",
        "description": "Error handling, recovery, and system resilience tests",
        "timeout_seconds": 60,
        "required_services": [
          "DenoiseService"
        ],
        "tests": [
          "test_error_recovery_and_resilience"
        ]
      }
    },
    "regression_testing": {
      "enabled": true,
      "baseline_directory": "test_baselines",
      "test_scenarios": [
        {
          "name": "denoise_performance",
          "service": "DenoiseService",
          "metrics": [
            "avg_latency_ms",
            "max_latency_ms", 
            "throughput_fps",
            "success_rate"
          ],
          "thresholds": {
            "latency_regression_percent": 10.0,
            "throughput_regression_percent": 5.0
          }
        },
        {
          "name": "aec_performance", 
          "service": "AECService",
          "metrics": [
            "avg_latency_ms",
            "echo_suppression_db",
            "processing_quality"
          ],
          "thresholds": {
            "latency_regression_percent": 10.0,
            "quality_regression_percent": 5.0
          }
        },
        {
          "name": "ssl_performance",
          "service": "SSLService", 
          "metrics": [
            "avg_latency_ms",
            "localization_accuracy",
            "tracking_stability"
          ],
          "thresholds": {
            "latency_regression_percent": 10.0,
            "accuracy_regression_percent": 3.0
          }
        }
      ]
    },
    "performance_requirements": {
      "latency": {
        "single_service_avg_ms": 3.0,
        "single_service_p95_ms": 5.0,
        "single_service_max_ms": 10.0,
        "pipeline_avg_ms": 8.0,
        "pipeline_p95_ms": 12.0,
        "pipeline_max_ms": 20.0
      },
      "throughput": {
        "min_fps": 80.0,
        "concurrent_streams": 4,
        "min_concurrent_fps": 50.0
      },
      "stability": {
        "max_error_rate": 0.01,
        "min_sustained_duration_seconds": 30.0,
        "max_memory_growth_mb": 50.0
      },
      "quality": {
        "min_snr_improvement_db": 3.0,
        "min_echo_suppression_db": 15.0,
        "min_speech_intelligibility": 0.7
      }
    },
    "reporting": {
      "output_directory": "integration_test_results",
      "report_formats": ["json", "html"],
      "include_detailed_logs": true,
      "include_performance_graphs": false,
      "save_test_artifacts": true
    },
    "ci_cd_integration": {
      "junit_xml_output": true,
      "exit_codes": {
        "success": 0,
        "warnings": 1, 
        "failure": 2,
        "error": 3
      },
      "failure_thresholds": {
        "max_failed_tests": 2,
        "min_success_rate": 0.85,
        "max_regression_count": 1
      }
    }
  }
}