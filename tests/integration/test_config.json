{
  "test_environments": {
    "minimal": {
      "description": "Minimal test environment for basic functionality",
      "project_structure": {
        "files": 5,
        "modules": 2,
        "unused_imports_per_file": 2,
        "dead_functions_per_file": 1
      }
    },
    "standard": {
      "description": "Standard test environment for comprehensive testing",
      "project_structure": {
        "files": 20,
        "modules": 5,
        "unused_imports_per_file": 3,
        "dead_functions_per_file": 2,
        "orphaned_files": 3,
        "unused_dependencies": 2
      }
    },
    "large": {
      "description": "Large test environment for performance testing",
      "project_structure": {
        "files": 100,
        "modules": 15,
        "unused_imports_per_file": 4,
        "dead_functions_per_file": 3,
        "orphaned_files": 10,
        "unused_dependencies": 5
      }
    }
  },
  "test_scenarios": {
    "import_cleanup": {
      "description": "Focus on unused import detection and removal",
      "config": {
        "analyze_imports": true,
        "analyze_dead_code": false,
        "analyze_files": false,
        "analyze_dependencies": false,
        "remove_unused_imports": true
      }
    },
    "dead_code_detection": {
      "description": "Focus on dead code detection",
      "config": {
        "analyze_imports": false,
        "analyze_dead_code": true,
        "analyze_files": false,
        "analyze_dependencies": false,
        "remove_dead_code": false
      }
    },
    "comprehensive": {
      "description": "Full analysis and cleanup",
      "config": {
        "analyze_imports": true,
        "analyze_dead_code": true,
        "analyze_files": true,
        "analyze_dependencies": true,
        "remove_unused_imports": true,
        "remove_dead_code": false,
        "remove_orphaned_files": false,
        "remove_unused_dependencies": false
      }
    }
  },
  "performance_thresholds": {
    "analysis_time_per_file_ms": 100,
    "max_total_analysis_time_s": 30,
    "memory_usage_mb": 500,
    "concurrent_operations": 5
  },
  "validation_rules": {
    "min_unused_imports_found": 1,
    "min_dead_code_items_found": 1,
    "backup_integrity_check": true,
    "rollback_verification": true
  }
}